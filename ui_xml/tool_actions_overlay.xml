<!-- Tool actions overlay: one tool of a tool changer, opened from its column -->
<!-- on the Tools panel. Three columns: on the left the change success rate -->
<!-- (green above 95%, amber below) over the filament form (material, colour, -->
<!-- Save); in the middle the same path drawn upright; on the right the -->
<!-- actions in three pairs. The tool shown is the tool_act_index subject; the path widget -->
<!-- and every label follow it, so one overlay serves every tool. -->
<component>
  <styles>
    <style name="tools_rate_unknown" text_color="#text_muted"/>
    <style name="tools_rate_good" text_color="#success"/>
    <style name="tools_rate_warn" text_color="#warning"/>
  </styles>
  <view name="tool_actions_overlay"
        extends="overlay_panel" title="Tool" title_subject="tool_act_title" bg_color="#screen_bg">
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_all="#space_md" style_pad_gap="#space_sm" flex_flow="column"
            scrollable="true">
      <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>

      <lv_obj name="tool_act_columns"
              width="100%" flex_grow="1" flex_flow="row" style_pad_all="0" style_pad_gap="#space_md"
              style_bg_opa="0" style_border_width="0" scrollable="false">

        <!-- ============================================================ -->
        <!-- LEFT: success rate, then the filament form                    -->
        <!-- ============================================================ -->
        <lv_obj name="tool_act_left"
                width="#tools_act_side_w" height="100%" flex_flow="column" style_pad_all="0"
                style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0" scrollable="true">

          <!-- Pick-up / drop-off record as one number. Takes whatever height
               the form leaves, so the column fills the page. -->
          <lv_obj name="tool_act_rate_card"
                  width="100%" flex_grow="1" flex_flow="column" style_flex_main_place="center"
                  style_flex_cross_place="center" style_pad_all="#space_sm" style_pad_gap="#space_xxs"
                  style_bg_color="#card_bg" style_bg_opa="255"
                  style_radius="#border_radius_small" style_border_width="1" style_border_color="#border"
                  scrollable="false">
            <text_small text="Change success" translation_tag="Change success" style_text_color="#text_muted"/>
            <lv_label name="tool_act_rate" bind_text="tool_act_rate" style_text_font="#font_display">
              <bind_style_if_eq name="tools_rate_unknown" subject="tool_act_rate_state" ref_value="0"/>
              <bind_style_if_eq name="tools_rate_good" subject="tool_act_rate_state" ref_value="1"/>
              <bind_style_if_eq name="tools_rate_warn" subject="tool_act_rate_state" ref_value="2"/>
            </lv_label>
            <text_body name="tool_act_pickups" width="100%" style_text_align="center"
                       bind_text="tool_act_pickups"/>
            <text_body name="tool_act_dropoffs" width="100%" style_text_align="center"
                       bind_text="tool_act_dropoffs"/>
          </lv_obj>

          <!-- The filament in this tool: edited here, saved with the button. -->
          <lv_obj name="tool_act_filament_form"
                  width="100%" height="content" flex_flow="column" style_pad_all="#space_sm"
                  style_pad_gap="#space_xs" style_bg_color="#card_bg" style_bg_opa="255"
                  style_radius="#border_radius_small" style_border_width="1" style_border_color="#border"
                  scrollable="false">
            <lv_obj width="100%"
                    height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
                    style_pad_gap="#space_xs" style_bg_opa="0" style_border_width="0" scrollable="false">
              <text_small text="Filament" translation_tag="Filament" style_text_color="#text_muted" flex_grow="1"/>
              <text_small name="tool_act_loaded" bind_text="tool_act_loaded" style_text_color="#text_muted"/>
            </lv_obj>
            <lv_dropdown name="tool_act_material_dd"
                         width="100%" height="content" options="PLA" style_radius="#border_radius"
                         style_border_width="0">
              <event_cb trigger="value_changed" callback="on_tool_act_material_changed"/>
            </lv_dropdown>
            <!-- Tap the block to pick a colour. -->
            <lv_obj name="tool_act_color_row"
                    width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
                    style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0" scrollable="false"
                    clickable="true">
              <event_cb trigger="clicked" callback="on_tool_act_pick_color"/>
              <lv_obj name="tool_act_color_block"
                      width="#tools_act_color" height="#tools_act_color" style_radius="#border_radius_small"
                      style_bg_color="#text_muted" style_bg_opa="255" style_border_width="1"
                      style_border_color="#border" scrollable="false" clickable="false" event_bubble="true"/>
              <text_body name="tool_act_color_name"
                         flex_grow="1" long_mode="dots" bind_text="tool_act_color_name" clickable="false"
                         event_bubble="true"/>
              <icon src="pencil" size="sm" variant="muted" clickable="false" event_bubble="true"/>
            </lv_obj>
            <ui_button name="tool_act_save" width="100%" text="Save" translation_tag="Save" variant="primary"
                       icon="content_save">
              <event_cb trigger="clicked" callback="on_tool_act_save"/>
              <bind_state_if_eq subject="tool_act_dirty" state="disabled" ref_value="0"/>
            </ui_button>
          </lv_obj>
        </lv_obj>

        <!-- ============================================================ -->
        <!-- MIDDLE: bowden in from the top, sensors, toolhead, nozzle      -->
        <!-- ============================================================ -->
        <lv_obj name="tool_act_middle"
                flex_grow="1" height="100%" flex_flow="column" style_flex_main_place="center"
                style_flex_cross_place="center" style_pad_all="0" style_bg_opa="0" style_border_width="0"
                scrollable="false">
          <tool_path name="tool_act_path" tool_subject="tool_act_index" mode="vertical" width="100%"
                     flex_grow="1"/>
          <text_small name="tool_act_status" width="100%" long_mode="wrap" style_text_align="center"
                      bind_text="tool_act_status" style_text_color="#text_muted"/>
        </lv_obj>

        <!-- ============================================================ -->
        <!-- RIGHT: the actions. Mount/dock is the tool change itself; the -->
        <!-- rest drive the tool's extruder through the printer's macros.  -->
        <!-- All of them move the machine, so a job holding it refuses them. -->
        <!-- ============================================================ -->
        <lv_obj name="tool_act_buttons"
                width="#tools_act_side_w" height="100%" flex_flow="column" style_pad_all="0"
                style_pad_gap="#space_lg" style_bg_opa="0" style_border_width="0" scrollable="false">
          <!-- Tool change: one of the pair shows, by whether the tool is on the carriage. -->
          <lv_obj name="tool_act_group_change"
                  width="100%" flex_grow="1" flex_flow="column" style_pad_all="0" style_pad_gap="#space_sm"
                  style_bg_opa="0" style_border_width="0" scrollable="false">
            <ui_button name="tool_act_mount"
                       width="100%" flex_grow="1" text="Pick up" translation_tag="Pick up" variant="primary"
                       icon="arrow_up_circle" moves_machine="true">
              <event_cb trigger="clicked" callback="on_tool_act_mount"/>
              <bind_state_if_eq subject="tool_act_busy" state="disabled" ref_value="1"/>
              <bind_flag_if_eq subject="tool_act_mounted" flag="hidden" ref_value="1"/>
            </ui_button>
            <ui_button name="tool_act_dock"
                       width="100%" flex_grow="1" text="Dock" translation_tag="Dock" variant="primary" icon="eject"
                       moves_machine="true">
              <event_cb trigger="clicked" callback="on_tool_act_mount"/>
              <bind_state_if_eq subject="tool_act_busy" state="disabled" ref_value="1"/>
              <bind_flag_if_eq subject="tool_act_mounted" flag="hidden" ref_value="0"/>
            </ui_button>
          </lv_obj>
          <!-- Filament in and out of the tool, through the printer's macros. -->
          <lv_obj name="tool_act_group_filament"
                  width="100%" flex_grow="1" flex_flow="column" style_pad_all="0" style_pad_gap="#space_sm"
                  style_bg_opa="0" style_border_width="0" scrollable="false">
            <ui_button name="tool_act_load"
                       width="100%" flex_grow="1" text="Load" translation_tag="Load" icon="download"
                       moves_machine="true">
              <event_cb trigger="clicked" callback="on_tool_act_load"/>
              <bind_state_if_eq subject="tool_act_busy" state="disabled" ref_value="1"/>
            </ui_button>
            <ui_button name="tool_act_unload"
                       width="100%" flex_grow="1" text="Unload" translation_tag="Unload" icon="arrow_up"
                       moves_machine="true">
              <event_cb trigger="clicked" callback="on_tool_act_unload"/>
              <bind_state_if_eq subject="tool_act_busy" state="disabled" ref_value="1"/>
            </ui_button>
          </lv_obj>
          <!-- A short move of the tool's extruder. -->
          <lv_obj name="tool_act_group_extrude"
                  width="100%" flex_grow="1" flex_flow="column" style_pad_all="0" style_pad_gap="#space_sm"
                  style_bg_opa="0" style_border_width="0" scrollable="false">
            <ui_button name="tool_act_extrude"
                       width="100%" flex_grow="1" text="Extrude" translation_tag="Extrude" icon="arrow_down_bold"
                       moves_machine="true">
              <event_cb trigger="clicked" callback="on_tool_act_extrude"/>
              <bind_state_if_eq subject="tool_act_busy" state="disabled" ref_value="1"/>
            </ui_button>
            <ui_button name="tool_act_retract"
                       width="100%" flex_grow="1" text="Retract" translation_tag="Retract"
                       icon="arrow_up_bold_circle" moves_machine="true">
              <event_cb trigger="clicked" callback="on_tool_act_retract"/>
              <bind_state_if_eq subject="tool_act_busy" state="disabled" ref_value="1"/>
            </ui_button>
          </lv_obj>
        </lv_obj>
      </lv_obj>
    </lv_obj>
  </view>
</component>
