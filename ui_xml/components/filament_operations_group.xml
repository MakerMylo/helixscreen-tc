<component>
  <!-- Filament operations (heading + Load/Unload/Purge + length selector +
       Extrude/Retract + cold-extrusion warning). Instantiated by both
       orientation branches of filament_panel.xml so the markup exists exactly
       once; the group grows into whatever slack its branch's column gives it. -->
  <styles>
    <!-- Reactive extrude length button state (L040: no inline bg attrs) -->
    <style name="extrude_length_btn_selected" bg_color="#primary" bg_opa="255"/>
    <style name="extrude_length_btn_unselected" bg_color="#primary" bg_opa="40"/>
  </styles>
  <view name="operations_group"
        extends="lv_obj" width="100%" height="0" flex_grow="1" style_pad_all="0" scrollable="false" flex_flow="column"
        style_pad_gap="#space_sm">
    <!-- Filament Operations Header. Hidden at MICRO, and on short portrait
         columns — the same rule that collapses the temp graph there
         (filament_portrait_graph_cramped in filament_panel.xml; spelled inline
         here because the two files cannot share the named subject). -->
    <text_body text="Operations" translation_tag="Operations" text_transform="uppercase" align="left_mid">
      <bind_flag_if_lt subject="ui_breakpoint" flag="hidden" ref_value="1"/>
      <bind_flag_if cond="ui_is_portrait eq 1 and ui_breakpoint_v lt 5" flag="hidden"/>
    </text_body>
    <!-- Load/Unload/Purge Row (macro-based, no length selector) -->
    <lv_obj width="100%"
            height="0" flex_grow="1" style_min_height="#button_height" style_pad_all="0" scrollable="false"
            flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center"
            style_pad_gap="#space_sm">
      <ui_button name="btn_load"
                 height="100%" flex_grow="1" icon="arrow_down" text="Load" translation_tag="Load"
                 style_text_font="#font_small" bind_op_state="filament_op_load_state">
        <bind_state_if_eq subject="filament_safety_warning_visible" state="disabled" ref_value="1"/>
        <bind_state_if_eq subject="filament_operation_in_progress" state="disabled" ref_value="1"/>
        <bind_state_if_eq subject="filament_load_disabled" state="disabled" ref_value="1"/>
        <event_cb trigger="clicked" callback="on_filament_load"/>
      </ui_button>
      <ui_button name="btn_unload"
                 height="100%" flex_grow="1" icon="arrow_up" text="Unload" translation_tag="Unload"
                 style_text_font="#font_small" bind_op_state="filament_op_unload_state">
        <bind_state_if_eq subject="filament_safety_warning_visible" state="disabled" ref_value="1"/>
        <bind_state_if_eq subject="filament_operation_in_progress" state="disabled" ref_value="1"/>
        <bind_state_if_eq subject="filament_unload_disabled" state="disabled" ref_value="1"/>
        <event_cb trigger="clicked" callback="on_filament_unload"/>
      </ui_button>
      <ui_button name="btn_purge"
                 height="100%" flex_grow="1" icon="trash_can_outline" text="Purge" translation_tag="Purge"
                 style_text_font="#font_small" bind_op_state="filament_op_purge_state">
        <bind_state_if_eq subject="filament_safety_warning_visible" state="disabled" ref_value="1"/>
        <bind_state_if_eq subject="filament_operation_in_progress" state="disabled" ref_value="1"/>
        <bind_state_if_eq subject="filament_unload_disabled" state="disabled" ref_value="1"/>
        <event_cb trigger="clicked" callback="on_filament_purge"/>
      </ui_button>
    </lv_obj>
    <!-- Length Selector -->
    <lv_obj name="extrude_length_row"
            width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="row"
            style_flex_main_place="start" style_flex_cross_place="center" style_pad_gap="#space_sm">
      <text_small text="Length:" translation_tag="Length:"/>
      <ui_button name="extrude_length_5mm"
                 height="#button_height_sm" flex_grow="1" text="5mm" style_text_font="#font_small">
        <bind_style name="extrude_length_btn_selected" subject="filament_extrude_length_5mm_active" ref_value="1"/>
        <bind_style name="extrude_length_btn_unselected" subject="filament_extrude_length_5mm_active" ref_value="0"/>
        <event_cb trigger="clicked" callback="on_filament_extrude_length_5mm"/>
      </ui_button>
      <ui_button name="extrude_length_10mm"
                 height="#button_height_sm" flex_grow="1" text="10mm" style_text_font="#font_small">
        <bind_style name="extrude_length_btn_selected" subject="filament_extrude_length_10mm_active" ref_value="1"/>
        <bind_style name="extrude_length_btn_unselected" subject="filament_extrude_length_10mm_active" ref_value="0"/>
        <event_cb trigger="clicked" callback="on_filament_extrude_length_10mm"/>
      </ui_button>
      <ui_button name="extrude_length_25mm"
                 height="#button_height_sm" flex_grow="1" text="25mm" style_text_font="#font_small">
        <bind_style name="extrude_length_btn_selected" subject="filament_extrude_length_25mm_active" ref_value="1"/>
        <bind_style name="extrude_length_btn_unselected" subject="filament_extrude_length_25mm_active" ref_value="0"/>
        <event_cb trigger="clicked" callback="on_filament_extrude_length_25mm"/>
      </ui_button>
    </lv_obj>
    <!-- Extrude/Retract Row (length-based operations) -->
    <lv_obj width="100%"
            height="0" flex_grow="1" style_min_height="#button_height" style_pad_all="0" scrollable="false"
            flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center"
            style_pad_gap="#space_sm">
      <ui_button name="btn_extrude"
                 height="100%" flex_grow="1" icon="arrow_down" text="Extrude" translation_tag="Extrude"
                 style_text_font="#font_small" bind_op_state="filament_op_extrude_state">
        <bind_state_if_eq subject="filament_safety_warning_visible" state="disabled" ref_value="1"/>
        <bind_state_if_eq subject="filament_operation_in_progress" state="disabled" ref_value="1"/>
        <event_cb trigger="clicked" callback="on_filament_extrude"/>
      </ui_button>
      <ui_button name="btn_retract"
                 height="100%" flex_grow="1" icon="arrow_up" text="Retract" translation_tag="Retract"
                 style_text_font="#font_small" bind_op_state="filament_op_retract_state">
        <bind_state_if_eq subject="filament_safety_warning_visible" state="disabled" ref_value="1"/>
        <bind_state_if_eq subject="filament_operation_in_progress" state="disabled" ref_value="1"/>
        <event_cb trigger="clicked" callback="on_filament_retract"/>
      </ui_button>
    </lv_obj>
    <!-- Safety Warning (compact inline - shows when cold) -->
    <lv_obj name="safety_warning"
            width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="row"
            style_flex_main_place="start" style_flex_cross_place="center" style_flex_track_place="center"
            style_pad_gap="#space_xs">
      <bind_flag_if_eq subject="filament_safety_warning_visible" flag="hidden" ref_value="0"/>
      <icon src="alert" size="sm" variant="warning"/>
      <text_small bind_text="filament_safety_warning_text"/>
    </lv_obj>
  </view>
</component>
