<component>
  <!-- Move tab: the bed as seen from above (back row on top) plus the action
       row. Shared by the portrait strip layout and the landscape rail layout,
       so the nine positions and their gating live in exactly one place. -->
  <styles>
    <!-- Same primary-pulse idiom as the jog mode toggle: the eight rim
         positions read as available, Center is the one solid anchor. -->
    <style name="preset_rim" bg_color="#primary" bg_opa="40"/>
    <style name="preset_center" bg_color="#primary" bg_opa="255"/>
  </styles>
  <view name="move_preset_grid"
        extends="lv_obj" width="100%" height="100%" style_pad_all="0" style_border_opa="0" scrollable="false"
        flex_flow="column" style_pad_gap="#space_xs">
    <!-- Every preset button is disabled while the panel's moves are gated:
       nav buttons off (not connected / klippy not ready) or a print active.
       The C++ handlers re-check both as a backstop. -->
    <lv_obj name="move_grid"
            width="100%" height="0" flex_grow="1" style_pad_all="0" style_border_opa="0" scrollable="false"
            flex_flow="column" style_pad_gap="#space_xs">
      <!-- Back row (+Y), far edge of the bed from the operator. -->
      <lv_obj name="preset_row_back"
              width="100%" height="0" flex_grow="1" style_pad_all="0" style_border_opa="0" scrollable="false"
              flex_flow="row" style_pad_gap="#space_xs">
        <ui_button name="preset_back_left"
                   width="0" height="100%" text="Back Left" translation_tag="Back Left" flex_grow="1"
                   moves_machine="true">
          <style name="preset_rim"/>
          <bind_state_if_eq subject="nav_buttons_enabled" state="disabled" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_motion_preset_clicked" user_data="back_left"/>
        </ui_button>
        <ui_button name="preset_back"
                   width="0" height="100%" text="Back" translation_tag="Back" flex_grow="1" moves_machine="true">
          <style name="preset_rim"/>
          <bind_state_if_eq subject="nav_buttons_enabled" state="disabled" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_motion_preset_clicked" user_data="back"/>
        </ui_button>
        <ui_button name="preset_back_right"
                   width="0" height="100%" text="Back Right" translation_tag="Back Right" flex_grow="1"
                   moves_machine="true">
          <style name="preset_rim"/>
          <bind_state_if_eq subject="nav_buttons_enabled" state="disabled" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_motion_preset_clicked" user_data="back_right"/>
        </ui_button>
      </lv_obj>
      <!-- Middle row: Left, Center, Right. -->
      <lv_obj name="preset_row_mid"
              width="100%" height="0" flex_grow="1" style_pad_all="0" style_border_opa="0" scrollable="false"
              flex_flow="row" style_pad_gap="#space_xs">
        <ui_button name="preset_left"
                   width="0" height="100%" text="Left" translation_tag="Left" flex_grow="1" moves_machine="true">
          <style name="preset_rim"/>
          <bind_state_if_eq subject="nav_buttons_enabled" state="disabled" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_motion_preset_clicked" user_data="left"/>
        </ui_button>
        <ui_button name="preset_center"
                   width="0" height="100%" text="Center" translation_tag="Center" flex_grow="1" moves_machine="true">
          <style name="preset_center"/>
          <bind_state_if_eq subject="nav_buttons_enabled" state="disabled" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_motion_preset_clicked" user_data="center"/>
        </ui_button>
        <ui_button name="preset_right"
                   width="0" height="100%" text="Right" translation_tag="Right" flex_grow="1" moves_machine="true">
          <style name="preset_rim"/>
          <bind_state_if_eq subject="nav_buttons_enabled" state="disabled" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_motion_preset_clicked" user_data="right"/>
        </ui_button>
      </lv_obj>
      <!-- Front row (-Y), nearest the operator. -->
      <lv_obj name="preset_row_front"
              width="100%" height="0" flex_grow="1" style_pad_all="0" style_border_opa="0" scrollable="false"
              flex_flow="row" style_pad_gap="#space_xs">
        <ui_button name="preset_front_left"
                   width="0" height="100%" text="Front Left" translation_tag="Front Left" flex_grow="1"
                   moves_machine="true">
          <style name="preset_rim"/>
          <bind_state_if_eq subject="nav_buttons_enabled" state="disabled" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_motion_preset_clicked" user_data="front_left"/>
        </ui_button>
        <ui_button name="preset_front"
                   width="0" height="100%" text="Front" translation_tag="Front" flex_grow="1" moves_machine="true">
          <style name="preset_rim"/>
          <bind_state_if_eq subject="nav_buttons_enabled" state="disabled" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_motion_preset_clicked" user_data="front"/>
        </ui_button>
        <ui_button name="preset_front_right"
                   width="0" height="100%" text="Front Right" translation_tag="Front Right" flex_grow="1"
                   moves_machine="true">
          <style name="preset_rim"/>
          <bind_state_if_eq subject="nav_buttons_enabled" state="disabled" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_motion_preset_clicked" user_data="front_right"/>
        </ui_button>
      </lv_obj>
    </lv_obj>
    <!-- Action row: Park runs the ParkToolhead macro (Front preset fallback),
         Motors off raises the shared confirmation. -->
    <lv_obj name="move_actions"
            width="100%" height="content" style_pad_all="0" style_border_opa="0" scrollable="false" flex_flow="row"
            style_pad_gap="#space_xs">
      <ui_button name="move_park"
                 width="0" height="#button_height" text="Park" translation_tag="Park" variant="secondary" flex_grow="1"
                 moves_machine="true">
        <bind_state_if_eq subject="nav_buttons_enabled" state="disabled" ref_value="0"/>
        <event_cb trigger="clicked" callback="on_motion_park_clicked"/>
      </ui_button>
      <ui_button name="move_motors_off"
                 width="0" height="#button_height" text="Motors Off" translation_tag="Motors Off" icon="power"
                 variant="secondary" flex_grow="1" moves_machine="true">
        <bind_state_if_eq subject="nav_buttons_enabled" state="disabled" ref_value="0"/>
        <event_cb trigger="clicked" callback="on_motion_motors_off_clicked"/>
      </ui_button>
    </lv_obj>
  </view>
</component>
